{
  "version": 1,
  "development_port_base": 5180,
  "path_replacements": {
    "pnpm-workspace.yaml": "bunfig.toml",
    "pnpm-lock.yaml": "bun.lock"
  },
  "command_replacements": [
    [
      "python -m unittest discover -s tests/fixtures",
      "uv run --frozen --project native python -m unittest discover -s tests/fixtures"
    ],
    [
      "pnpm exec ",
      "bun x --no-install "
    ],
    [
      "pnpm ",
      "bun run "
    ]
  ],
  "scope_additions": {
    "T01": [
      "AGENTS.md",
      "tsconfig.json",
      "tests/bootstrap/",
      "packages/*/package.json",
      "packages/*/tsconfig.json",
      "config/acceptance-commands.json",
      "config/test-toolchain.json",
      "native/inkflip/__init__.py",
      "native/tests/bootstrap/",
      "apps/web/src/styles/",
      "scripts/test_results.py",
      "scripts/acceptance_receipts.py",
      "docs/ACCEPTANCE.md"
    ],
    "T02": [
      "bunfig.toml",
      "tests/build/",
      "apps/web/public/",
      "patches/",
      "config/dependency-patches.json"
    ],
    "T03": [
      "native/tests/contracts/"
    ],
    "T49": [
      "LICENSE",
      "CONTRIBUTING.md",
      "SECURITY.md"
    ]
  },
  "reserved_paths": [
    "planning/",
    "scripts/coordination.py",
    "tests/coordination/",
    "execution/overrides.json",
    "docs/COORDINATION.md",
    "prompts/"
  ]
}

{
  "_purpose": "Data rules for scripts/check_claims.py. Edit here to tighten or relax a rule; the checker has no policy of its own. 'checked_docs' entries are interpreted relative to the repository root; relative link targets inside each doc are resolved against the doc's own directory.",
  "required_docs": [
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/quickstart.md",
    "docs/user-guide.md",
    "docs/developer-guide.md",
    "docs/architecture.md",
    "docs/limitations.md",
    "docs/development-history.md"
  ],
  "checked_docs": [
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/quickstart.md",
    "docs/user-guide.md",
    "docs/developer-guide.md",
    "docs/architecture.md",
    "docs/limitations.md",
    "docs/development-history.md"
  ],
  "forbidden_phrases": [
    "what AI sees",
    "AI sees",
    "fully autonomous",
    "unhackable",
    "100% accurate",
    "completely safe",
    "guaranteed safe",
    "risk score",
    "trust score",
    "safety score",
    "fraud detection feature",
    "fraud-free",
    "cannot be tampered with"
  ],
  "version_pins": [
    {
      "name": "pdfjs-dist",
      "doc_pattern": "PDF\\.js\\s+([0-9]+\\.[0-9]+\\.[0-9]+)",
      "pin_file": "apps/web/package.json",
      "pin_json_path": "dependencies.pdfjs-dist"
    },
    {
      "name": "tesseract.js",
      "doc_pattern": "Tesseract\\.js\\s+([0-9]+\\.[0-9]+\\.[0-9]+)",
      "pin_file": "apps/web/package.json",
      "pin_regex": "\"tesseract\\.js\":\\s*\"([0-9.]+)\""
    },
    {
      "name": "react",
      "doc_pattern": "React\\s+([0-9]+\\.[0-9]+\\.[0-9]+)",
      "pin_file": "apps/web/package.json",
      "pin_json_path": "dependencies.react"
    },
    {
      "name": "vite",
      "doc_pattern": "Vite\\s+([0-9]+\\.[0-9]+\\.[0-9]+)",
      "pin_file": "apps/web/package.json",
      "pin_json_path": "devDependencies.vite"
    },
    {
      "name": "bun",
      "doc_pattern": "Bun\\s+([0-9]+\\.[0-9]+\\.[0-9]+)",
      "pin_file": "package.json",
      "pin_json_path": "packageManager",
      "pin_regex": "bun@([0-9.]+)"
    },
    {
      "name": "python-pin",
      "doc_pattern": "Python\\s+(3\\.13\\.[0-9]+)",
      "pin_file": ".python-version",
      "pin_regex": "^([0-9.]+)\\s*$"
    },
    {
      "name": "pypdf",
      "doc_pattern": "pypdf\\s+([0-9]+\\.[0-9]+\\.[0-9]+)",
      "pin_file": "native/pyproject.toml",
      "pin_regex": "pypdf==([0-9.]+)"
    },
    {
      "name": "pypdfium2",
      "doc_pattern": "pypdfium2\\s+([0-9]+\\.[0-9]+\\.[0-9]+)",
      "pin_file": "native/pyproject.toml",
      "pin_regex": "pypdfium2==([0-9.]+)"
    }
  ],
  "license_rules": {
    "must_match": {
      "README.md": "not yet decided or shipped",
      "SECURITY.md": "no dedicated security-reporting channel exists yet",
      "docs/limitations.md": "licen[cs]e.{0,120}pending|pending.{0,120}licen[cs]e"
    },
    "must_not_match": {
      "README.md": "licen[cs]ed under (the )?MIT",
      "CONTRIBUTING.md": "licen[cs]ed under (the )?MIT",
      "SECURITY.md": "licen[cs]ed under (the )?MIT"
    }
  },
  "doc_facts": {
    "docs/limitations.md": {
      "must_contain": [
        "bun run test:browser` fails",
        "never-used machine has not been performed",
        "cold-cache\\s+install behavior was not measured"
      ],
      "must_not_contain": [
        "bun run test:browser` passes"
      ]
    },
    "docs/quickstart.md": {
      "must_contain": [
        "empty dependency tree",
        "were not measured"
      ]
    },
    "README.md": {
      "must_contain": [
        "not\\s+a\\s+claim\\s+about\\s+PDFs\\s+in\\s+general"
      ],
      "must_not_contain": [
        "test:browser` \\| passes"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inkflip:schema:1.0.0",
  "title": "Inkflip canonical contracts v1",
  "oneOf": [
    {
      "$ref": "#/$defs/Report"
    },
    {
      "$ref": "#/$defs/Comparison"
    },
    {
      "$ref": "#/$defs/AcceptanceRules"
    },
    {
      "$ref": "#/$defs/CorpusManifest"
    },
    {
      "$ref": "#/$defs/Baseline"
    },
    {
      "$ref": "#/$defs/ReaderManifest"
    },
    {
      "$ref": "#/$defs/WorkerMessage"
    }
  ],
  "$defs": {
    "Point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "Matrix": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "Box": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "Geometry": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "estimated",
            "page_only",
            "unknown"
          ]
        },
        "space": {
          "const": "canonical_page"
        },
        "polygon": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 3,
              "maxItems": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "transform_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "maxItems": 16
        },
        "basis": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "precision",
        "space",
        "polygon",
        "transform_ids",
        "basis"
      ],
      "additionalProperties": false
    },
    "Transform": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "from_space": {
          "type": "string",
          "maxLength": 100
        },
        "to_space": {
          "type": "string",
          "maxLength": 100
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "inverse": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "operation": {
          "type": "string",
          "enum": [
            "page_box_to_canonical",
            "display_rotation",
            "raster_scale",
            "crop_translation",
            "viewport",
            "ocr_resize"
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "estimated"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "page_index",
        "from_space",
        "to_space",
        "matrix",
        "inverse",
        "operation",
        "precision",
        "source"
      ],
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "media_box": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "crop_box": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_view_box": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "box_source": {
          "type": "string",
          "maxLength": 200
        },
        "user_unit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "canonical_size_pt": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "raw_to_canonical_transform_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 32
        }
      },
      "required": [
        "index",
        "media_box",
        "crop_box",
        "effective_view_box",
        "box_source",
        "user_unit",
        "rotation",
        "canonical_size_pt",
        "raw_to_canonical_transform_id",
        "limitations"
      ],
      "additionalProperties": false
    },
    "Capability": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "render",
            "native_text",
            "ocr",
            "object_render_mode",
            "crop_metadata",
            "paint_overlap",
            "reading_order",
            "alignment"
          ]
        },
        "support": {
          "type": "string",
          "enum": [
            "supported",
            "approximate",
            "experimental",
            "unavailable"
          ]
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 32
        }
      },
      "required": [
        "name",
        "support",
        "limits"
      ],
      "additionalProperties": false
    },
    "Reader": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "maxLength": 100
        },
        "build": {
          "type": "string",
          "maxLength": 256
        },
        "adapter_version": {
          "const": "1.0.0"
        },
        "method": {
          "type": "string",
          "enum": [
            "native_text",
            "ocr",
            "structure",
            "render"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "browser",
            "native",
            "node"
          ]
        },
        "settings": {
          "type": "object",
          "properties": {
            "normalization": {
              "const": "scalar-whitespace-v1"
            },
            "language": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ]
            },
            "psm": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 13
                },
                {
                  "type": "null"
                }
              ]
            },
            "render_reader_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,95}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "raster_dpi": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "annotation_mode": {
              "type": "string",
              "enum": [
                "static_appearance",
                "none",
                "not_applicable"
              ]
            }
          },
          "required": [
            "normalization",
            "language",
            "psm",
            "render_reader_id",
            "raster_dpi",
            "annotation_mode"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "model_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maxItems": 16
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "build",
        "adapter_version",
        "method",
        "environment",
        "settings",
        "capabilities",
        "model_hashes",
        "limitations"
      ],
      "additionalProperties": false
    },
    "RawMap": {
      "type": "object",
      "properties": {
        "raw_start": {
          "type": "integer",
          "minimum": 0
        },
        "raw_end": {
          "type": "integer",
          "minimum": 0
        },
        "normalized_start": {
          "type": "integer",
          "minimum": 0
        },
        "normalized_end": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "enum": [
            "identity",
            "whitespace"
          ]
        }
      },
      "required": [
        "raw_start",
        "raw_end",
        "normalized_start",
        "normalized_end",
        "operation"
      ],
      "additionalProperties": false
    },
    "EngineScore": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "scale_min": {
          "type": "number"
        },
        "scale_max": {
          "type": "number"
        },
        "meaning": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "value",
        "scale_min",
        "scale_max",
        "meaning"
      ],
      "additionalProperties": false
    },
    "Occurrence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "reader_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "raw_text": {
          "type": "string",
          "maxLength": 2000000
        },
        "normalized_text": {
          "type": "string",
          "maxLength": 2000000
        },
        "normalization_map": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RawMap"
          },
          "maxItems": 2000000
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "engine_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineScore"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_source_locator": {
          "type": "string",
          "maxLength": 1000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "reader_id",
        "page_index",
        "ordinal",
        "raw_text",
        "normalized_text",
        "normalization_map",
        "geometry",
        "engine_score",
        "source_asset_id",
        "raw_source_locator",
        "limitations"
      ],
      "additionalProperties": false
    },
    "Region": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "page_index",
        "geometry",
        "label"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reading_difference",
            "observed_structure",
            "ocr_interpretation",
            "mechanism_hypothesis",
            "incomplete_check"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "explanation": {
          "type": "string",
          "maxLength": 4000
        },
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "occurrence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "maxItems": 32
        },
        "check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "alignment": {
          "type": "string",
          "enum": [
            "unique",
            "ambiguous",
            "unmatched",
            "page_level",
            "not_applicable"
          ]
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "selected",
            "material_token",
            "ordinary",
            "informational"
          ]
        },
        "basis": {
          "type": "string",
          "maxLength": 4000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "explanation",
        "page_index",
        "occurrence_ids",
        "check_ids",
        "alignment",
        "region_id",
        "priority",
        "basis",
        "limitations"
      ],
      "additionalProperties": false
    },
    "Annotation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        },
        "author_label": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "const": "human_entered"
        }
      },
      "required": [
        "id",
        "finding_id",
        "page_index",
        "text",
        "author_label",
        "origin"
      ],
      "additionalProperties": false
    },
    "CheckPlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "reader_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "capability": {
          "type": "string",
          "enum": [
            "render",
            "native_text",
            "ocr",
            "object_render_mode",
            "crop_metadata",
            "paint_overlap",
            "reading_order",
            "alignment"
          ]
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "page_index",
        "reader_ids",
        "capability",
        "region_id"
      ],
      "additionalProperties": false
    },
    "CheckResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "unsupported",
            "timeout",
            "cancelled",
            "failed",
            "skipped"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "produced_occurrence_count": {
          "type": "integer",
          "minimum": 0
        },
        "retained_occurrence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "maxItems": 100000
        }
      },
      "required": [
        "id",
        "status",
        "reason",
        "produced_occurrence_count",
        "retained_occurrence_ids"
      ],
      "additionalProperties": false
    },
    "Plan": {
      "type": "object",
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "selected_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Region"
          },
          "maxItems": 100
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CheckPlan"
          },
          "minItems": 1,
          "maxItems": 16000
        },
        "normalization_version": {
          "const": "scalar-whitespace-v1"
        },
        "alignment_version": {
          "const": "region-match-v1"
        },
        "profile": {
          "type": "string",
          "enum": [
            "desktop",
            "mobile",
            "native"
          ]
        },
        "budget": {
          "type": "object",
          "properties": {
            "max_raster_pixels": {
              "type": "integer",
              "minimum": 1
            },
            "max_run_ocr_pixels": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "max_raster_pixels",
            "max_run_ocr_pixels",
            "timeout_ms",
            "max_retries"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "selected_pages",
        "regions",
        "checks",
        "normalization_version",
        "alignment_version",
        "profile",
        "budget"
      ],
      "additionalProperties": false
    },
    "Document": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "source_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sha256",
        "byte_length",
        "page_count",
        "display_name",
        "source_asset_id"
      ],
      "additionalProperties": false
    },
    "Asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "image/png",
            "application/pdf"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "type": "string",
          "enum": [
            "crop",
            "page_render",
            "source_pdf"
          ]
        },
        "data_base64": {
          "type": "string",
          "maxLength": 28000000,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "pixel_size": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "page_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geometry"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "media_type",
        "sha256",
